<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             xmlns:models="clr-namespace:CosmicMusic.Models"
             x:Class="CosmicMusic.Views.SearchPage"
             x:DataType="viewmodels:SearchViewModel"
             BackgroundColor="{StaticResource PrimaryDark}"
             Title="Search">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter"/>

            <x:String x:Key="IconPrevious">M6,6H8V18H6M9.5,12L18,18V6</x:String>
            <x:String x:Key="IconNext">M16,18H18V6H16M6,18L14.5,12L6,6</x:String>
            <x:String x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</x:String>
            <x:String x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" Margin="20,10,20,10" StrokeShape="RoundRectangle 10" BackgroundColor="#333" StrokeThickness="0" Padding="10,0">
            <Grid ColumnDefinitions="30, *, 30">
                <ImageButton Grid.Column="0" Command="{Binding StartSearchingCommand}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Start">
                    <ImageButton.Source>
                        <FontImageSource Glyph="🔍" Color="#AAA" Size="20"/>
                    </ImageButton.Source>
                </ImageButton>

                <Entry Grid.Column="1" 
                       Text="{Binding SearchText}"
                       Placeholder="Songs, Artists, Podcasts" 
                       PlaceholderColor="#AAA" 
                       TextColor="White" 
                       VerticalOptions="Center">
                    <Entry.Behaviors>
                        <toolkit:EventToCommandBehavior EventName="Focused" Command="{Binding StartSearchingCommand}" />
                    </Entry.Behaviors>
                </Entry>

                <ImageButton Grid.Column="2" 
                             Command="{Binding GoBackCommand}" 
                             BackgroundColor="Transparent" 
                             HeightRequest="30" WidthRequest="30"
                             IsVisible="{Binding IsExploring, Converter={StaticResource InvertedBoolConverter}}">
                    <ImageButton.Source>
                        <FontImageSource Glyph="✖" Color="White" Size="18"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <ScrollView IsVisible="{Binding IsExploring}" Padding="20,0,20,80">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Browse All" FontFamily="MontserratBold" FontSize="18" TextColor="White"/>

                    <CollectionView ItemsSource="{Binding BrowseCategories}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:BrowseCategory">
                                <Border HeightRequest="110" 
                                        StrokeShape="RoundRectangle 10" 
                                        StrokeThickness="0">
                                    <Grid>
                                        <BoxView>
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{Binding StartColor}" Offset="0.0"/>
                                                    <GradientStop Color="{Binding EndColor}" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <Label Text="{Binding Icon}" 
                                               FontSize="50" 
                                               HorizontalOptions="End" 
                                               VerticalOptions="End" 
                                               Rotation="-20" 
                                               TranslationX="10" 
                                               TranslationY="10"
                                               Opacity="0.8"/>

                                        <Label Text="{Binding Title}" 
                                               FontFamily="MontserratBold" 
                                               FontSize="18" 
                                               TextColor="White" 
                                               Margin="15,15,0,0"
                                               HorizontalOptions="Start" 
                                               VerticalOptions="Start"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <CollectionView IsVisible="{Binding IsExploring, Converter={StaticResource InvertedBoolConverter}}"
                            ItemsSource="{Binding SearchResults}"
                            SelectionMode="None"
                            Margin="0,10,0,80">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Song">
                        <Grid Padding="20,10" ColumnDefinitions="60, *, 40">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SearchViewModel}}, Path=SelectSongCommand}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            <Frame Grid.Column="0" CornerRadius="5" Padding="0" IsClippedToBounds="True" HeightRequest="50" WidthRequest="50">
                                <Image Source="{Binding CoverImage}" Aspect="AspectFill"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                                <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Artist}" TextColor="#AAA" FontSize="14" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="2" BackgroundColor="Transparent" IsEnabled="False" VerticalOptions="Center">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="▶" Color="#AAA" Size="20"/>
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Margin="15,0,15,15" 
                    Padding="0"
                    Stroke="{StaticResource CosmicPink}"
                    StrokeThickness="1"
                    BackgroundColor="#252535"
                    StrokeShape="RoundRectangle 15"
                    HeightRequest="65"
                    VerticalOptions="End">

                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.5"/>
                </Border.Shadow>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Border.Triggers>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToPlayerCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="65, *, 40, 40, 40" ColumnSpacing="0" Margin="0,0,10,0">

                    <Frame Grid.Column="0" Padding="0" IsClippedToBounds="True" CornerRadius="15" Margin="5" BorderColor="Transparent" BackgroundColor="Transparent">
                        <Image Source="{Binding AudioPlayer.CurrentSong.CoverImage}" Aspect="AspectFill"/>
                    </Frame>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="5,0">
                        <Label Text="{Binding AudioPlayer.CurrentSong.Title}" FontFamily="MontserratBold" FontSize="13" TextColor="White" LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding AudioPlayer.CurrentSong.Artist}" FontFamily="MontserratRegular" FontSize="11" TextColor="#AAA" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <Grid Grid.Column="2" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.PreviousCommand}"/>
                        </Grid.GestureRecognizers>
                        <Path Data="{StaticResource IconPrevious}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>

                    <Grid Grid.Column="3" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.PlayPauseCommand}"/>
                        </Grid.GestureRecognizers>
                        <Path Data="{StaticResource IconPlay}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding AudioPlayer.IsPlaying}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>

                    <Grid Grid.Column="4" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.NextCommand}"/>
                        </Grid.GestureRecognizers>
                        <Path Data="{StaticResource IconNext}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>