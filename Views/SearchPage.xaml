<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             xmlns:models="clr-namespace:CosmicMusic.Models"
             x:Class="CosmicMusic.Views.SearchPage"
             x:DataType="viewmodels:SearchViewModel"
             Title="Search"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E0B28" Offset="0.0" />
            <GradientStop Color="#050208" Offset="0.5" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <toolkit:BoolToObjectConverter x:Key="BoolToVisibleConverter" TrueObject="True" FalseObject="False"/>
            <Color x:Key="CosmicPink">#D946EF</Color>

            <x:String x:Key="IconPrevious">M6,6H8V18H6M9.5,12L18,18V6</x:String>
            <x:String x:Key="IconNext">M16,18H18V6H16M6,18L14.5,12L6,6</x:String>
            <x:String x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</x:String>
            <x:String x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <Label Grid.Row="0" 
               Text="Search" 
               FontFamily="MontserratBold" 
               FontSize="28" 
               TextColor="White" 
               Margin="20,20,20,10"/>

        <Border Grid.Row="1" 
                Margin="20,0,20,20" 
                StrokeShape="RoundRectangle 8" 
                BackgroundColor="#332A38" 
                StrokeThickness="0" 
                HeightRequest="50" 
                Padding="15,0">
            <Grid ColumnDefinitions="30, *, 30">
                <ImageButton Grid.Column="0" Command="{Binding PerformSearchCommand}" HeightRequest="22" WidthRequest="22" HorizontalOptions="Start">
                    <ImageButton.Source>
                        <FontImageSource Glyph="🔍" Color="#AAA" Size="22"/>
                    </ImageButton.Source>
                </ImageButton>

                <Entry Grid.Column="1" 
                       Text="{Binding SearchText}"
                       Placeholder="Songs, artists, or playlists" 
                       PlaceholderColor="#888" 
                       TextColor="White" 
                       FontSize="16"
                       FontFamily="MontserratRegular"
                       VerticalOptions="Center"
                       Margin="5,0"
                       ClearButtonVisibility="WhileEditing" 
                       ReturnCommand="{Binding PerformSearchCommand}">
                </Entry>

                <ImageButton Grid.Column="2" 
                             Command="{Binding GoBackCommand}" 
                             BackgroundColor="Transparent" 
                             HeightRequest="30" WidthRequest="30"
                             IsVisible="{Binding IsExploring, Converter={StaticResource InvertedBoolConverter}}">
                    <ImageButton.Source>
                        <FontImageSource Glyph="✖" Color="#AAA" Size="18"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <CollectionView IsVisible="{Binding IsExploring}" 
                ItemsSource="{Binding BrowseCategories}"
                Margin="20,0,20,90">

                <CollectionView.Header>
                    <Label Text="Top Genres" FontFamily="MontserratBold" FontSize="18" TextColor="White" Margin="0,0,0,15"/>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:BrowseCategory">
                        <Border HeightRequest="100" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent">
                            <Grid>
                                <BoxView>
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{Binding StartColor}" Offset="0.0"/>
                                            <GradientStop Color="{Binding EndColor}" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>
                                <Label Text="{Binding Title}" FontFamily="MontserratBold" FontSize="16" TextColor="White" Margin="12" HorizontalOptions="Start" VerticalOptions="End"/>
                                <Label Text="{Binding Icon}" FontSize="50" HorizontalOptions="End" VerticalOptions="End" Rotation="25" TranslationX="15" TranslationY="5" Opacity="0.9"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource CosmicPink}"
                               VerticalOptions="Start"
                               HorizontalOptions="Center"
                               Margin="0,20,0,0"/>

            <CollectionView IsVisible="{Binding IsExploring, Converter={StaticResource InvertedBoolConverter}}"
                            ItemsSource="{Binding SearchResults}"
                            SelectionMode="None"
                            Margin="0,0,0,90">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="🔍" FontSize="40" HorizontalOptions="Center" TextColor="#666"/>
                        <Label Text="No songs found" FontSize="16" TextColor="#888" FontFamily="MontserratRegular"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Song">
                        <Grid Padding="20,10" ColumnDefinitions="55, *, 40">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SearchViewModel}}, Path=SelectSongCommand}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Padding="0" HeightRequest="50" WidthRequest="50" StrokeThickness="0" BackgroundColor="Transparent">
                                <Image Source="{Binding CoverImage}" Aspect="AspectFill"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0" Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Title}" TextColor="White" FontFamily="MontserratBold" FontSize="15" LineBreakMode="TailTruncation" MaximumWidthRequest="180"/>
                                    <Border IsVisible="{Binding IsPremium}" BackgroundColor="#FFD700" StrokeThickness="0" Padding="5,0" HeightRequest="16" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                        <Label Text="VIP" TextColor="Black" FontSize="9" FontFamily="MontserratBold" VerticalOptions="Center"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Artist}" TextColor="#AAA" FontFamily="MontserratRegular" FontSize="13" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="2" Text="▶" TextColor="White" FontSize="14" VerticalOptions="Center" HorizontalOptions="End" Opacity="0.5"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Margin="15,0,15,15" 
                    Padding="0"
                    Stroke="{StaticResource CosmicPink}"
                    StrokeThickness="1"
                    BackgroundColor="#251035"
                    StrokeShape="RoundRectangle 12"
                    HeightRequest="65"
                    VerticalOptions="End">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.7"/>
                </Border.Shadow>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Border.Triggers>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToPlayerCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="60, *, 40, 40" ColumnSpacing="0">
                    <Border Grid.Column="0" Padding="0" StrokeShape="RoundRectangle 8" Margin="8" StrokeThickness="0" BackgroundColor="Transparent">
                        <Image Source="{Binding AudioPlayer.CurrentSong.CoverImage}" Aspect="AspectFill"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="5,0">
                        <Label Text="{Binding AudioPlayer.CurrentSong.Title}" FontFamily="MontserratBold" FontSize="13" TextColor="White" LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding AudioPlayer.CurrentSong.Artist}" FontFamily="MontserratRegular" FontSize="11" TextColor="#BBB" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <Grid Grid.Column="2" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.ToggleFavoriteCommand}"/>
                        </Grid.GestureRecognizers>
                        <Label Text="❤" TextColor="{Binding AudioPlayer.FavoriteColor}" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Grid>

                    <Grid Grid.Column="3" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" Margin="0,0,5,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.PlayPauseCommand}"/>
                        </Grid.GestureRecognizers>
                        <Path Data="{StaticResource IconPlay}" Fill="White" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding AudioPlayer.IsPlaying}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>