<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             x:Class="CosmicMusic.Views.PremiumPage"
             x:DataType="viewmodels:PremiumViewModel"
             Shell.NavBarIsVisible="False"
             Title="Premium" 
             BackgroundColor="#0D0416">

    <ContentPage.Resources>
        <ResourceDictionary>
            <x:String x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</x:String>
            <Color x:Key="CosmicPink">#FF00CC</Color>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto">

            <Grid Grid.Row="0" HeightRequest="300">
                <Border StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#8E2DE2" Offset="0.0" />
                            <GradientStop Color="#4A00E0" Offset="0.6" />
                            <GradientStop Color="#0D0416" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <VerticalStackLayout VerticalOptions="End" Padding="30">
                    <Label Text="LIMITED TIME OFFER" TextColor="Black" BackgroundColor="#00E5FF" HorizontalOptions="Start" Padding="10,5" FontSize="12" FontAttributes="Bold"/>
                    <Label Text="Get 3 months of Premium for free" TextColor="White" FontSize="36" FontFamily="MontserratBold" Margin="0,15,0,0" LineHeight="1.1"/>
                </VerticalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1" Padding="30,0">
                <VerticalStackLayout Spacing="25">
                    <Label Text="Experience the ultimate way to listen. Ad-free, offline, and on any device." TextColor="#CCC" FontSize="15" LineHeight="1.2"/>
                    <Label Text="Only $5.99/month after. Cancel anytime." TextColor="White" FontAttributes="Bold" FontSize="15"/>

                    <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                        <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="#00E5FF" Aspect="Uniform" HeightRequest="20" VerticalOptions="Start"/>
                        <Label Grid.Column="1" Text="Ad-free music listening" TextColor="White" FontSize="16"/>
                    </Grid>
                    <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                        <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="#00E5FF" Aspect="Uniform" HeightRequest="20" VerticalOptions="Start"/>
                        <Label Grid.Column="1" Text="Download to listen offline" TextColor="White" FontSize="16"/>
                    </Grid>
                    <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                        <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="#00E5FF" Aspect="Uniform" HeightRequest="20" VerticalOptions="Start"/>
                        <Label Grid.Column="1" Text="Play songs in any order" TextColor="White" FontSize="16"/>
                    </Grid>
                    <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                        <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="#00E5FF" Aspect="Uniform" HeightRequest="20" VerticalOptions="Start"/>
                        <Label Grid.Column="1" Text="High quality audio (320kbps)" TextColor="White" FontSize="16"/>
                    </Grid>
                    <BoxView HeightRequest="20"/>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" Padding="30,20,30,40">
                <Button Text="GET 3 MONTHS FREE" 
                        Command="{Binding ShowPaymentPopupCommand}"
                        TextColor="White" FontFamily="MontserratBold" FontSize="16" CornerRadius="25" HeightRequest="55">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00E5FF" Offset="0.0" />
                            <GradientStop Color="#0072FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#00E5FF" Offset="0,0" Radius="20" Opacity="0.6"/>
                    </Button.Shadow>
                </Button>
            </Grid>
        </Grid>

        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsPaymentVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelCommand}"/>
            </Grid.GestureRecognizers>
        </Grid>

        <Border IsVisible="{Binding IsPaymentVisible}"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                WidthRequest="320"
                HeightRequest="550" 
                BackgroundColor="#16213E"
                Stroke="{StaticResource CosmicPink}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

            <VerticalStackLayout Spacing="20">
                <Label Text="Quét mã để thanh toán" 
                       TextColor="White" 
                       FontFamily="MontserratBold" 
                       FontSize="20" 
                       HorizontalOptions="Center"/>

                <Label Text="Nội dung: COSMIC [EMAIL CỦA BẠN]" 
                       TextColor="#AAA" 
                       FontSize="12" 
                       HorizontalOptions="Center"/>

                <Frame CornerRadius="10" 
                       IsClippedToBounds="True" 
                       HasShadow="False"
                       Padding="0"
                       HeightRequest="250" 
                       WidthRequest="250"
                       HorizontalOptions="Center"
                       BorderColor="Transparent">
                    <Image Source="qrcode.jpg" Aspect="AspectFill" BackgroundColor="White"/>
                </Frame>

                <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                   IsVisible="{Binding IsBusy}" 
                                   Color="#00E5FF"/>

                <Button Text="TÔI ĐÃ CHUYỂN KHOẢN" 
                        Command="{Binding ConfirmPaymentCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#00E5FF"
                        TextColor="#0D0416"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,5,0,0"/>

                <Label Text="Hủy bỏ" 
                       TextColor="#FF4757" 
                       HorizontalOptions="Center"
                       TextDecorations="Underline"
                       Padding="10">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>