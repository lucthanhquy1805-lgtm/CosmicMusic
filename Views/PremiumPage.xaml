<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             xmlns:models="clr-namespace:CosmicMusic.Models"
             x:Class="CosmicMusic.Views.PremiumPage"
             x:DataType="viewmodels:PremiumViewModel"
             Shell.NavBarIsVisible="False"
             Title="Premium" 
             BackgroundColor="#0D0416">

    <ContentPage.Resources>
        <ResourceDictionary>
            <x:String x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</x:String>
            <Color x:Key="CosmicPink">#FF00CC</Color>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto, *">

            <Grid Grid.Row="0" HeightRequest="250">
                <Border StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#8E2DE2" Offset="0.0" />
                            <GradientStop Color="#4A00E0" Offset="0.6" />
                            <GradientStop Color="#0D0416" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <ImageButton Command="{Binding GoBackCommand}" 
                             HorizontalOptions="Start" VerticalOptions="Start" 
                             Margin="20,40,0,0"
                             HeightRequest="30" WidthRequest="30" BackgroundColor="Transparent">
                    <ImageButton.Source>
                        <FontImageSource Glyph="❮" Color="White" Size="20"/>
                    </ImageButton.Source>
                </ImageButton>

                <VerticalStackLayout VerticalOptions="End" Padding="30">
                    <Label Text="COSMIC PREMIUM" TextColor="Black" BackgroundColor="#00E5FF" HorizontalOptions="Start" Padding="10,5" FontSize="12" FontFamily="MontserratBold"/>
                    <Label Text="Trải nghiệm âm nhạc không giới hạn" TextColor="White" FontSize="28" FontFamily="MontserratBold" Margin="0,15,0,0" LineHeight="1.1"/>
                </VerticalStackLayout>
            </Grid>

            <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#00E5FF" VerticalOptions="Start" Margin="0,20,0,0"/>

            <CollectionView Grid.Row="1" ItemsSource="{Binding SubscriptionPackages}" Margin="0,10,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="20"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Subscription">

                        <Border Margin="20,0" Padding="20" StrokeThickness="1" Stroke="#33FFFFFF" StrokeShape="RoundRectangle 20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{Binding BackgroundColor}" Offset="0.0" />
                                    <GradientStop Color="#16213E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontFamily="MontserratBold" FontSize="22" TextColor="White"/>
                                    <Label Grid.Column="1" Text="{Binding Price}" FontFamily="MontserratBold" FontSize="20" TextColor="#00E5FF"/>
                                </Grid>

                                <Label Text="{Binding Description}" FontFamily="MontserratRegular" FontSize="14" TextColor="#DDD" Margin="0,0,0,10"/>

                                <BoxView HeightRequest="1" Color="#44FFFFFF" Margin="0,5,0,15"/>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Features}" Spacing="12" Margin="0,0,0,25">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="30, *">
                                                <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="#00E5FF" Aspect="Uniform" HeightRequest="18" VerticalOptions="Start" Margin="0,2,0,0"/>
                                                <Label Grid.Column="1" Text="{Binding .}" TextColor="White" FontSize="15" FontFamily="MontserratRegular"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Button Text="Nâng cấp ngay" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PremiumViewModel}}, Path=BuySubscriptionCommand}" 
                                        CommandParameter="{Binding .}"
                                        TextColor="White" FontFamily="MontserratBold" FontSize="16" CornerRadius="25" HeightRequest="55">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5FF" Offset="0.0" />
                                            <GradientStop Color="#0072FF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Shadow>
                                        <Shadow Brush="#00E5FF" Offset="0,0" Radius="15" Opacity="0.5"/>
                                    </Button.Shadow>
                                </Button>
                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="40" BackgroundColor="Transparent"/>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>


        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsPaymentVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelCommand}"/>
            </Grid.GestureRecognizers>
        </Grid>

        <Border IsVisible="{Binding IsPaymentVisible}"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                WidthRequest="320"
                HeightRequest="550" 
                BackgroundColor="#16213E"
                Stroke="{StaticResource CosmicPink}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

            <VerticalStackLayout Spacing="20">
                <Label Text="Quét mã để thanh toán" 
                       TextColor="White" 
                       FontFamily="MontserratBold" 
                       FontSize="20" 
                       HorizontalOptions="Center"/>

                <Label Text="Nội dung: COSMIC [EMAIL CỦA BẠN]" 
                       TextColor="#AAA" 
                       FontSize="12" 
                       HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 10" 
                        Padding="0"
                        HeightRequest="250" 
                        WidthRequest="250"
                        HorizontalOptions="Center"
                        StrokeThickness="0">
                    <Image Source="qrcode.jpg" Aspect="AspectFill" BackgroundColor="White"/>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                   IsVisible="{Binding IsBusy}" 
                                   Color="#00E5FF"/>

                <Button Text="TÔI ĐÃ CHUYỂN KHOẢN" 
                        Command="{Binding ConfirmPaymentCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#00E5FF"
                        TextColor="#0D0416"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,5,0,0"/>

                <Label Text="Hủy bỏ" 
                       TextColor="#FF4757" 
                       HorizontalOptions="Center"
                       TextDecorations="Underline"
                       Padding="10">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>