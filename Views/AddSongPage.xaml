<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             xmlns:models="clr-namespace:CosmicMusic.Models"
             x:Class="CosmicMusic.Views.AddSongPage"
             x:DataType="viewmodels:AddSongViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#120520">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" Margin="20,40,20,10" ColumnDefinitions="Auto, *">
            <ImageButton Grid.Column="0" Command="{Binding GoBackCommand}" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30" HorizontalOptions="Start">
                <ImageButton.Source>
                    <FontImageSource Glyph="❮" Color="White" Size="20"/>
                </ImageButton.Source>
            </ImageButton>
            <Label Grid.Column="1" Text="Thêm nhạc vào Cosmic" FontAttributes="Bold" FontSize="20" TextColor="#00E5FF" HorizontalOptions="Center" Margin="-30,0,0,0"/>
        </Grid>

        <Border Grid.Row="1" Margin="20,10,20,10" StrokeShape="RoundRectangle 10" BackgroundColor="#251035" StrokeThickness="0" HeightRequest="55" Padding="15,0">
            <Grid ColumnDefinitions="*, Auto">
                <Entry Grid.Column="0" Text="{Binding SearchText}" Placeholder="Tìm tên bài hát / ca sĩ trên Apple..." TextColor="White" PlaceholderColor="#888" VerticalOptions="Center" ReturnCommand="{Binding SearchApiCommand}"/>
                <ImageButton Grid.Column="1" Command="{Binding SearchApiCommand}" BackgroundColor="Transparent" HeightRequest="25" WidthRequest="25">
                    <ImageButton.Source>
                        <FontImageSource Glyph="🔍" Color="#00E5FF" Size="22"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </Border>
        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#00E5FF" VerticalOptions="Center" HorizontalOptions="Center" HeightRequest="50"/>

        <CollectionView Grid.Row="2" ItemsSource="{Binding ApiSearchResults}" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid Padding="20,10" ColumnDefinitions="55, *, Auto">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Padding="0" StrokeThickness="0" HeightRequest="50" WidthRequest="50">
                            <Image Source="{Binding CoverImage}" Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0" Spacing="2">
                            <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" MaximumWidthRequest="160"/>
                            <Label Text="{Binding Artist}" TextColor="#AAA" FontSize="12" LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2" Text="+ Thêm" BackgroundColor="#00E5FF" TextColor="#120520" FontAttributes="Bold" CornerRadius="15" HeightRequest="35" Padding="12,0"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddSongViewModel}}, Path=SelectAndUploadSongCommand}" CommandParameter="{Binding .}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>