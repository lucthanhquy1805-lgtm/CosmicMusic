<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             x:Class="CosmicMusic.Views.ChangePasswordPage"
             x:DataType="viewmodels:ChangePasswordViewModel"
             BackgroundColor="#120520"
             Title="Đổi mật khẩu">

    <Grid RowDefinitions="Auto, *" Padding="20">

        <Label Grid.Row="0" Text="Bảo mật tài khoản" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="0,0,0,30"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="5">
                    <Label Text="Mật khẩu hiện tại" TextColor="#AAA"/>
                    <Border Stroke="#6C63FF" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#252535" HeightRequest="50" Padding="15,0">
                        <Entry Text="{Binding OldPassword}" IsPassword="True" Placeholder="Nhập mật khẩu cũ" TextColor="White" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Mật khẩu mới" TextColor="#AAA"/>
                    <Border Stroke="#6C63FF" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#252535" HeightRequest="50" Padding="15,0">
                        <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Ít nhất 6 ký tự" TextColor="White" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Xác nhận mật khẩu mới" TextColor="#AAA"/>
                    <Border Stroke="#6C63FF" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#252535" HeightRequest="50" Padding="15,0">
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Nhập lại mật khẩu mới" TextColor="White" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Lưu thay đổi" 
                        Command="{Binding ChangePasswordCommand}" 
                        BackgroundColor="#6C63FF" 
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,20,0,0"
                        FontAttributes="Bold"/>

                <Button Text="Hủy bỏ" 
                        Command="{Binding CancelCommand}" 
                        BackgroundColor="Transparent" 
                        TextColor="#FF4757"
                        Margin="0,10,0,0"/>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#6C63FF" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>