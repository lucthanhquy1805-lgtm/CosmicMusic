<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             xmlns:models="clr-namespace:CosmicMusic.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CosmicMusic.Views.AlbumDetailPage"
             x:DataType="viewmodels:AlbumDetailViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.BackgroundColor>
        <Color>#120520</Color>
    </ContentPage.BackgroundColor>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <x:String x:Key="IconPrevious">M6,6H8V18H6M9.5,12L18,18V6</x:String>
            <x:String x:Key="IconNext">M16,18H18V6H16M6,18L14.5,12L6,6</x:String>
            <x:String x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</x:String>
            <x:String x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</x:String>
            <x:String x:Key="IconCrown">M5,16L3,5L8.5,10L12,4L15.5,10L21,5L19,16H5M19,19H5V17H19V19Z</x:String>
            <x:String x:Key="IconMore">M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">

        <Image Grid.RowSpan="2" 
               Source="{Binding CoverImage}" 
               Aspect="AspectFill" 
               Opacity="0.6" 
               VerticalOptions="Fill" 
               HorizontalOptions="Fill"/>

        <BoxView Grid.RowSpan="2" VerticalOptions="Fill" HorizontalOptions="Fill">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00120520" Offset="0.0" />
                    <GradientStop Color="#802a0e45" Offset="0.4" />
                    <GradientStop Color="#E6120520" Offset="0.8" />
                    <GradientStop Color="#FF120520" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <CollectionView Grid.Row="0" ItemsSource="{Binding Songs}" SelectionMode="None" BackgroundColor="Transparent">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="15" Padding="20,100,20,20">

                    <Frame HeightRequest="200" WidthRequest="200" CornerRadius="20" Padding="0" IsClippedToBounds="True" BorderColor="Transparent" HorizontalOptions="Center">
                        <Frame.Shadow>
                            <Shadow Brush="#8E2DE2" Offset="0,10" Radius="30" Opacity="0.6"/>
                        </Frame.Shadow>
                        <Image Source="{Binding CoverImage}" Aspect="AspectFill"/>
                    </Frame>

                    <Label Text="{Binding MainTitle}" FontSize="28" FontAttributes="Bold" TextColor="White" 
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2">
                        <Label.Shadow>
                            <Shadow Brush="#120520" Offset="2,2" Radius="5" Opacity="1.0"/>
                        </Label.Shadow>
                    </Label>

                    <Label Text="{Binding SubTitle}" 
                           TextColor="#E0B0FF" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" 
                           LineBreakMode="WordWrap"
                           MaxLines="2"
                           Margin="0,0,0,10"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <Button Grid.Column="0" Text="Phát Ngay" Command="{Binding PlayAllCommand}"
                                BackgroundColor="{StaticResource CosmicPink}" TextColor="White" 
                                CornerRadius="25" FontAttributes="Bold" HeightRequest="54">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource CosmicPink}" Offset="0,0" Radius="20" Opacity="0.7"/>
                            </Button.Shadow>
                        </Button>

                        <Button Grid.Column="1" Text="Ngẫu Nhiên" Command="{Binding ShuffleAllCommand}"
                                BackgroundColor="#33FFFFFF" TextColor="White" 
                                BorderColor="White" BorderWidth="1"
                                CornerRadius="25" FontAttributes="Bold" HeightRequest="54"/>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid Padding="20,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AlbumDetailViewModel}}, Path=PlaySongCommand}" CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="♫" TextColor="#D8BFD8" FontSize="18" VerticalOptions="Center" Margin="0,0,20,0"/>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" TextColor="White" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" MaximumWidthRequest="220"/>
                                <Border IsVisible="{Binding IsPremium}" BackgroundColor="#FFD700" StrokeThickness="0" Padding="6,2" HeightRequest="18" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Path Data="{StaticResource IconCrown}" Fill="Black" Aspect="Uniform" HeightRequest="10" WidthRequest="10" VerticalOptions="Center"/>
                                        <Label Text="VIP" TextColor="Black" FontSize="10" FontFamily="MontserratBold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Artist}" TextColor="#E0B0FF" FontSize="13" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AlbumDetailViewModel}}, Path=OpenOptionMenuCommand}" 
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            <Path Data="{StaticResource IconMore}" Fill="#E0B0FF" Aspect="Uniform" HeightRequest="20" WidthRequest="20" 
                                  HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                           Color="{StaticResource CosmicPink}" VerticalOptions="Center" HorizontalOptions="Center"/>

        <ImageButton Grid.Row="0" Source="{FontImageSource Glyph='‹', Color='White', Size=40, FontFamily='OpenSansRegular'}" 
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="15,10" HeightRequest="40" WidthRequest="40"
                     BackgroundColor="#33000000" CornerRadius="20" Command="{Binding GoBackCommand}"/>

        <Border Grid.Row="1" Margin="15,0,15,15" Padding="0" 
                Stroke="{StaticResource CosmicPink}" StrokeThickness="1" 
                BackgroundColor="#251035" StrokeShape="RoundRectangle 20" HeightRequest="70" VerticalOptions="End">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.5"/>
            </Border.Shadow>

            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="False">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="True">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Border.Triggers>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavigateToPlayerCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="70, *, 40, 40, 40" ColumnSpacing="0" Margin="0,0,10,0">
                <Frame Grid.Column="0" Padding="0" IsClippedToBounds="True" CornerRadius="20" Margin="5" BorderColor="Transparent" BackgroundColor="Transparent">
                    <Image Source="{Binding AudioPlayer.CurrentSong.CoverImage}" Aspect="AspectFill"/>
                </Frame>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="5,0">
                    <Label Text="{Binding AudioPlayer.CurrentSong.Title}" FontFamily="MontserratBold" FontSize="14" TextColor="White" LineBreakMode="TailTruncation" FontAttributes="Bold"/>
                    <Label Text="{Binding AudioPlayer.CurrentSong.Artist}" FontFamily="MontserratRegular" FontSize="12" TextColor="#D8BFD8" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
                <Grid Grid.Column="2" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AudioPlayer.PreviousCommand}"/>
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource IconPrevious}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
                <Grid Grid.Column="3" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AudioPlayer.PlayPauseCommand}"/>
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource IconPlay}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding AudioPlayer.IsPlaying}" Value="True">
                                <Setter Property="Data" Value="{StaticResource IconPause}"/>
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
                <Grid Grid.Column="4" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AudioPlayer.NextCommand}"/>
                    </Grid.GestureRecognizers>
                    <Path Data="{StaticResource IconNext}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ContentPage>