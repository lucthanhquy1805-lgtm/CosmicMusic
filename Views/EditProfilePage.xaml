<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             x:Class="CosmicMusic.Views.EditProfilePage"
             x:DataType="viewmodels:EditProfileViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2E004F" Offset="0.0" />
            <GradientStop Color="#120520" Offset="0.4" />
            <GradientStop Color="#050208" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="50, *" Padding="15,40,15,20">
            <ImageButton Grid.Column="0" Command="{Binding CancelCommand}" BackgroundColor="Transparent" HeightRequest="40" WidthRequest="40" HorizontalOptions="Start">
                <ImageButton.Source>
                    <FontImageSource Glyph="❮" Color="White" Size="20"/>
                </ImageButton.Source>
            </ImageButton>
            <Label Grid.Column="1" Text="Chỉnh sửa hồ sơ" TextColor="White" FontSize="20" FontFamily="MontserratBold" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Padding="20,10">
            <VerticalStackLayout Spacing="30">

                <Label Text="Tạo dấu ấn của bạn trong vũ trụ Cosmic Music. Tên hiển thị này sẽ được dùng trong các Playlist và bình luận." 
                       TextColor="#AAA" FontSize="14" FontFamily="MontserratRegular" LineHeight="1.5" Margin="0,0,0,10"/>

                <VerticalStackLayout Spacing="8">
                    <Label Text="TÊN HIỂN THỊ" TextColor="#E0B0FF" FontSize="13" FontFamily="MontserratBold"/>
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1.5" Stroke="#D946EF" BackgroundColor="#251035" Padding="15,5">
                        <Entry Text="{Binding NewName}" 
                               Placeholder="Nhập tên của bạn" 
                               PlaceholderColor="#555" 
                               TextColor="White" 
                               BackgroundColor="Transparent" 
                               FontFamily="MontserratBold"
                               ClearButtonVisibility="WhileEditing"/>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="20,20,20,40">
            <Button Text="LƯU THAY ĐỔI" 
                    Command="{Binding SaveChangesCommand}"
                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#D946EF" 
                    TextColor="White" 
                    FontFamily="MontserratBold" 
                    FontSize="16" 
                    CornerRadius="25" 
                    HeightRequest="55">
                <Button.Shadow>
                    <Shadow Brush="#D946EF" Offset="0,5" Radius="15" Opacity="0.5"/>
                </Button.Shadow>
            </Button>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="#D946EF" 
                               HorizontalOptions="Center" 
                               HeightRequest="40" WidthRequest="40"/>
        </Grid>

    </Grid>
</ContentPage>