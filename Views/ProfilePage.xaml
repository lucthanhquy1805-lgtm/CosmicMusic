<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             x:Class="CosmicMusic.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             BackgroundColor="#120520"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" HeightRequest="60" Padding="15,0">

            <ImageButton Source="{FontImageSource Glyph='⬅', FontFamily='OpenSansRegular', Color='White', Size=24}"
                         HorizontalOptions="Start" VerticalOptions="Center"
                         Command="{Binding GoBackCommand}"
                         BackgroundColor="Transparent"/>

            <ImageButton Source="{FontImageSource Glyph='⚙', FontFamily='OpenSansRegular', Color='White', Size=24}"
                         HorizontalOptions="End" VerticalOptions="Center"
                         Command="{Binding OpenSettingsCommand}"
                         BackgroundColor="Transparent"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,20">

                <Border StrokeShape="RoundRectangle 60" 
                        StrokeThickness="0"
                        BackgroundColor="#A569F7" 
                        HeightRequest="120" 
                        WidthRequest="120"
                        HorizontalOptions="Center">
                    <Label Text="{Binding UserAvatarText}" 
                           TextColor="White" 
                           FontSize="48" 
                           FontFamily="MontserratBold" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"/>
                </Border>

                <Label Text="{Binding UserName}" 
                       TextColor="White" 
                       FontSize="28" 
                       FontFamily="MontserratBold" 
                       HorizontalOptions="Center"/>

                <Label Text="{Binding UserEmail}" 
                       TextColor="#AAA" 
                       FontSize="14" 
                       HorizontalOptions="Center"
                       Margin="0,-10,0,0"/>

                <Button Text="Chỉnh sửa hồ sơ"
                        Command="{Binding OpenEditPageCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        BorderColor="White"
                        BorderWidth="1"
                        CornerRadius="20"
                        HeightRequest="40"
                        WidthRequest="150"
                        FontSize="12"
                        FontAttributes="Bold"
                        Margin="0,10,0,0"/>

                <Grid ColumnDefinitions="*, *" Padding="40,20">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="23" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="PLAYLISTS" TextColor="#AAA" FontSize="10" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="120" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="FOLLOWING" TextColor="#AAA" FontSize="10" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#33FFFFFF" Margin="20,0"/>

                <Label Text="Danh sách phát công khai" TextColor="White" FontSize="16" FontAttributes="Bold" Margin="20,10"/>

                <Label Text="Bạn chưa có danh sách phát nào." TextColor="#888" HorizontalOptions="Center" Margin="0,30"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>