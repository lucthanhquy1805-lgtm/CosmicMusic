<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:CosmicMusic.ViewModels"
             xmlns:models="clr-namespace:CosmicMusic.Models"
             x:Class="CosmicMusic.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             BackgroundColor="{StaticResource PrimaryDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <toolkit:BoolToObjectConverter x:Key="BoolToIconConverter" TrueObject="⏸" FalseObject="▶"/>

            <x:String x:Key="IconUserOutline">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</x:String>
            <x:String x:Key="IconSettings">M19.14,12.94C19.17,12.64 19.2,12.32 19.2,12C19.2,11.68 19.17,11.36 19.14,11.06L21.16,9.38C21.34,9.23 21.4,8.97 21.28,8.77L19.37,5.46C19.25,5.25 19,5.17 18.77,5.25L16.39,6.25C15.89,5.85 15.35,5.5 14.77,5.24L14.41,2.6C14.38,2.37 14.18,2.2 13.95,2.2H10.05C9.82,2.2 9.62,2.37 9.59,2.6L9.23,5.24C8.65,5.5 8.11,5.85 7.61,6.25L5.23,5.25C5,5.17 4.75,5.25 4.63,5.46L2.72,8.77C2.6,8.97 2.66,9.23 2.84,9.38L4.86,11.06C4.83,11.36 4.8,11.68 4.8,12C4.8,12.32 4.83,12.64 4.86,12.94L2.84,14.62C2.66,14.77 2.6,15.03 2.72,15.23L4.63,18.54C4.75,18.75 5,18.83 5.23,18.75L7.61,17.75C8.11,18.15 8.65,18.5 9.23,18.76L9.59,21.4C9.62,21.63 9.82,21.8 10.05,21.8H13.95C14.18,21.8 14.38,21.63 14.41,21.4L14.77,18.76C15.35,18.5 15.89,18.15 16.39,17.75L18.77,18.75C19,18.83 19.25,18.75 19.37,18.54L21.28,15.23C21.4,15.03 21.34,14.77 21.16,14.62L19.14,12.94M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5Z</x:String>
            <x:String x:Key="IconLogout">M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z</x:String>
            <x:String x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</x:String>
            <x:String x:Key="IconLightning">M7,2V11H3L13,21V11H17L7,2Z</x:String>
            <x:String x:Key="IconChart">M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.46,19H22V21H2V19L10.23,4.75L16,11.78Z</x:String>
            <x:String x:Key="IconClock">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</x:String>

            <x:String x:Key="IconPrevious">M6,6H8V18H6M9.5,12L18,18V6</x:String>
            <x:String x:Key="IconNext">M16,18H18V6H16M6,18L14.5,12L6,6</x:String>
            <x:String x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</x:String>
            <x:String x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <toolkit:MediaElement x:Name="appMediaElement"
                              ShouldAutoPlay="False"
                              IsVisible="False" 
                              Source="{Binding AudioPlayer.CurrentSong.AudioUrl}"
                              Volume="{Binding AudioPlayer.Volume}" />

        <Grid RowDefinitions="*, Auto">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="25" Padding="20,10,20,30">

                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 25" StrokeThickness="2" Stroke="#33FFFFFF" BackgroundColor="{Binding AvatarBorderColor}" HeightRequest="50" WidthRequest="50" HorizontalOptions="Start">
                            <Label Text="{Binding UserAvatarText}" TextColor="White" FontSize="24" FontAttributes="Bold" FontFamily="MontserratBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapUserAvatarCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Label Grid.Column="1" Text="Home" TextColor="White" FontSize="20" FontFamily="MontserratBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <ImageButton Grid.Column="2" Source="{FontImageSource Glyph='🔍', FontFamily='OpenSansRegular', Color='#AAA'}" HeightRequest="30" Command="{Binding NavigateToSearchCommand}" BackgroundColor="Transparent"/>
                    </Grid>

                    <Label Text="Good morning" FontFamily="MontserratBold" FontSize="28" TextColor="White"/>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Featured Playlists" FontFamily="MontserratBold" FontSize="20" TextColor="White"/>
                        <CollectionView ItemsSource="{Binding Playlist}" HeightRequest="220">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Song">
                                    <Frame HeightRequest="220" WidthRequest="220" CornerRadius="20" Padding="0" IsClippedToBounds="True" BorderColor="Transparent" BackgroundColor="#2A2A40">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=OpenAlbumCommand}" CommandParameter="{Binding .}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid RowDefinitions="*, Auto">
                                            <Image Grid.Row="0" Source="{Binding CoverImage}" Aspect="AspectFill"/>
                                            <VerticalStackLayout Grid.Row="1" Padding="15">
                                                <Label Text="{Binding Title}" FontFamily="MontserratBold" FontSize="16" TextColor="White" LineBreakMode="TailTruncation"/>
                                                <Label Text="Playlist" FontFamily="MontserratRegular" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="New Releases" FontFamily="MontserratBold" FontSize="20" TextColor="White"/>
                        <CollectionView ItemsSource="{Binding Playlist}" HeightRequest="180">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Song">
                                    <Frame HeightRequest="180" WidthRequest="150" CornerRadius="15" Padding="0" IsClippedToBounds="True" BorderColor="Transparent" BackgroundColor="#2A2A40">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=OpenAlbumCommand}" CommandParameter="{Binding .}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid RowDefinitions="*, Auto">
                                            <Image Grid.Row="0" Source="{Binding CoverImage}" Aspect="AspectFill" HeightRequest="120"/>
                                            <VerticalStackLayout Grid.Row="1" Padding="10">
                                                <Label Text="{Binding Title}" FontFamily="MontserratBold" FontSize="14" TextColor="White" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Artist}" FontFamily="MontserratRegular" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Recently Played" FontFamily="MontserratBold" FontSize="20" TextColor="White"/>
                        <CollectionView ItemsSource="{Binding Playlist}" SelectionMode="None" HeightRequest="300">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Song">
                                    <Grid Padding="0,5">
                                        <Frame CornerRadius="15" HasShadow="False" BackgroundColor="#2A2A40" Padding="10" BorderColor="Transparent" HeightRequest="70">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=SelectSongCommand}" CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="50, *, Auto" ColumnSpacing="15">
                                                <Frame Grid.Column="0" CornerRadius="10" Padding="0" IsClippedToBounds="True">
                                                    <Image Source="{Binding CoverImage}" Aspect="AspectFill"/>
                                                </Frame>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding Title}" FontFamily="MontserratBold" FontSize="15" TextColor="White"/>
                                                    <Label Text="{Binding Artist}" FontFamily="MontserratRegular" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                                                </VerticalStackLayout>
                                                <ImageButton Grid.Column="2" VerticalOptions="Center" BackgroundColor="Transparent" IsEnabled="False">
                                                    <ImageButton.Source>
                                                        <FontImageSource Glyph="▶" Color="{StaticResource CosmicPink}" Size="24"/>
                                                    </ImageButton.Source>
                                                </ImageButton>
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <Border Grid.Row="1" Margin="15,0,15,15" Padding="0" Stroke="{StaticResource CosmicPink}" StrokeThickness="1" BackgroundColor="#252535" StrokeShape="RoundRectangle 15" HeightRequest="65" VerticalOptions="End">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.5"/>
                </Border.Shadow>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding AudioPlayer.CurrentSong, Converter={StaticResource IsNotNullConverter}}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Border.Triggers>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToPlayerCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="65, *, 40, 40, 40" ColumnSpacing="0" Margin="0,0,10,0">

                    <Frame Grid.Column="0" Padding="0" IsClippedToBounds="True" CornerRadius="15" Margin="5" BorderColor="Transparent" BackgroundColor="Transparent">
                        <Image Source="{Binding AudioPlayer.CurrentSong.CoverImage}" Aspect="AspectFill"/>
                    </Frame>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="5,0">
                        <Label Text="{Binding AudioPlayer.CurrentSong.Title}" FontFamily="MontserratBold" FontSize="13" TextColor="White" LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding AudioPlayer.CurrentSong.Artist}" FontFamily="MontserratRegular" FontSize="11" TextColor="#AAA" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <Grid Grid.Column="2" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.PreviousCommand}"/>
                        </Grid.GestureRecognizers>
                        <Path Data="{StaticResource IconPrevious}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>

                    <Grid Grid.Column="3" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.PlayPauseCommand}"/>
                        </Grid.GestureRecognizers>
                        <Path Data="{StaticResource IconPlay}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding AudioPlayer.IsPlaying}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>

                    <Grid Grid.Column="4" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AudioPlayer.NextCommand}"/>
                        </Grid.GestureRecognizers>
                        <Path Data="{StaticResource IconNext}" Fill="{StaticResource CosmicPink}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <Grid BackgroundColor="#AA000000" IsVisible="{Binding IsUserMenuVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseUserMenuCommand}"/>
            </Grid.GestureRecognizers>
        </Grid>

        <Border IsVisible="{Binding IsUserMenuVisible}" HorizontalOptions="Start" VerticalOptions="Fill" WidthRequest="320" BackgroundColor="#120520" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="5,0" Radius="20" Opacity="0.8"/>
            </Border.Shadow>
            <Grid RowDefinitions="Auto, *, Auto" Padding="25,40,20,30">
                <Grid Grid.Row="0" ColumnDefinitions="60, *" ColumnSpacing="15" Margin="0,0,0,30">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 30" StrokeThickness="2" Stroke="#FFD700" BackgroundColor="{Binding AvatarBorderColor}" HeightRequest="60" WidthRequest="60">
                        <Label Text="{Binding UserAvatarText}" TextColor="White" FontSize="26" FontFamily="MontserratBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding UserName}" TextColor="White" FontSize="20" FontFamily="MontserratBold"/>
                        <Label Text="Xem hồ sơ" TextColor="#AAA" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenProfileCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Grid>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="25">
                        <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                            <Path Grid.Column="0" Data="{StaticResource IconPlus}" Fill="White" Aspect="Uniform" HeightRequest="22"/>
                            <Label Grid.Column="1" Text="Thêm tài khoản" TextColor="White" FontSize="16" FontFamily="MontserratRegular" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddAccountCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                            <Path Grid.Column="0" Data="{StaticResource IconLightning}" Fill="White" Aspect="Uniform" HeightRequest="22"/>
                            <Label Grid.Column="1" Text="Có gì mới" TextColor="White" FontSize="16" FontFamily="MontserratRegular" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenWhatsNewCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                            <Path Grid.Column="0" Data="{StaticResource IconChart}" Fill="White" Aspect="Uniform" HeightRequest="22"/>
                            <Label Grid.Column="1" Text="Số liệu hoạt động nghe" TextColor="White" FontSize="16" FontFamily="MontserratRegular" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenStatsCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                            <Path Grid.Column="0" Data="{StaticResource IconClock}" Fill="White" Aspect="Uniform" HeightRequest="22"/>
                            <Label Grid.Column="1" Text="Gần đây" TextColor="White" FontSize="16" FontFamily="MontserratRegular" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenHistoryCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <Grid ColumnDefinitions="30, *" ColumnSpacing="15">
                            <Path Grid.Column="0" Data="{StaticResource IconSettings}" Fill="White" Aspect="Uniform" HeightRequest="22"/>
                            <Label Grid.Column="1" Text="Cài đặt và quyền riêng tư" TextColor="White" FontSize="16" FontFamily="MontserratRegular" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSettingsCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
                <Button Grid.Row="2" Text="Đăng xuất" Command="{Binding PerformLogoutCommand}" BackgroundColor="#2A2A40" TextColor="White" FontFamily="MontserratBold" CornerRadius="25" HeightRequest="50" Margin="0,20,0,0"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>