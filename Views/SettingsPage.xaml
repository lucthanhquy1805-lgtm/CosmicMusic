<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CosmicMusic.Views.SettingsPage"
             BackgroundColor="#120520"
             Title="Cài đặt">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Label Text="Tài khoản" TextColor="White" FontAttributes="Bold" Margin="20,20,20,10"/>

            <Grid Padding="20,15" BackgroundColor="#1E1E2C">
                <Label Text="Đổi mật khẩu" TextColor="White" VerticalOptions="Center"/>
                <Label Text="›" TextColor="#888" FontSize="24" HorizontalOptions="End" VerticalOptions="Center"/>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChangePasswordTapped"/>
                </Grid.GestureRecognizers>
            </Grid>

            <BoxView HeightRequest="1" Color="#333"/>

            <Grid Padding="20,15" BackgroundColor="#1E1E2C">
                <Label Text="Quyền riêng tư" TextColor="White" VerticalOptions="Center"/>
                <Label Text="›" TextColor="#888" FontSize="24" HorizontalOptions="End" VerticalOptions="Center"/>
            </Grid>

            <Label Text="Hệ thống" TextColor="White" FontAttributes="Bold" Margin="20,30,20,10"/>

            <Grid Padding="20,15" BackgroundColor="#1E1E2C">
                <Label Text="Chất lượng âm thanh" TextColor="White" VerticalOptions="Center"/>
                <Label Text="Cao (320kbps)" TextColor="#888" HorizontalOptions="End" Margin="0,0,30,0" VerticalOptions="Center"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>